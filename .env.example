# Pick one. pi also reads credentials from ~/.pi/agent/auth.json if you have run `pi` before.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# provider:model - see `pi models` for the full list
HARNESS_MODEL=anthropic:claude-opus-5

# Which messaging adapter to boot. "cli" ships working. The rest are yours to build.
HARNESS_ADAPTER=cli

# Where memory lives. Point this somewhere private if your memory holds real people.
# In a container both of these belong on a volume, or a restart is amnesia.
HARNESS_MEMORY_DIR=./memory
HARNESS_PROPOSALS_DIR=./reflection/proposals
